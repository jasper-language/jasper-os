diff --git a/target/sw64/helper.c b/target/sw64/helper.c
index e317c08..a46cc8b 100644
--- a/target/sw64/helper.c
+++ b/target/sw64/helper.c
@@ -394,8 +394,22 @@ uint64_t helper_read_csr(CPUSW64State *env, uint64_t index)
 {
     if (index == PRI_BASE)
 	env->csr[index] = 0x10000;
-    if (index == SHTCLOCK)
-	env->csr[index] = qemu_clock_get_ns(QEMU_CLOCK_HOST) / 40;
+#ifdef CONFIG_USER_ONLY
+    /*
+     * RTID (CSR 0xc7) supplies the thread-private base used by the SW64 TLS
+     * sequence (`rtid r0; addl tls_offset,r0,r0`).  linux-user stores that
+     * base in env->unique when CLONE_SETTLS or the ABI TLS syscall runs.
+     */
+    if (index == TID)
+        env->csr[index] = env->unique;
+#endif
+    if (index == SHTCLOCK) {
+#ifdef CONFIG_USER_ONLY
+        env->csr[index] = (uint64_t)g_get_monotonic_time() * 1000 / 40;
+#else
+        env->csr[index] = qemu_clock_get_ns(QEMU_CLOCK_HOST) / 40;
+#endif
+    }
     return env->csr[index];
 }
